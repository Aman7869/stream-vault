NODE_ENV=development
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=streamvault
DB_USER=root
DB_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=1d
# JWT_EXPIRES_IN=15m
# dummy referesh token secret for testing, change in production
REFRESH_TOKEN_SECRET=change-this-refresh-secret-in-production
REFRESH_TOKEN_EXPIRES_IN=7d

# Stripe (optional — leave blank to disable payments)
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

# Bunny Stream (optional — leave blank to disable video upload)
BUNNY_STORAGE_ZONE=your_storage_zone
BUNNY_API_KEY=your_bunny_api_key
BUNNY_LIBRARY_ID=your_library_id
BUNNY_HOSTNAME=your_hostname
# BunnyCDN Pull Zone Token Authentication key (from CDN → Security → Token Authentication)
# When set, all CDN stream URLs are signed with a 4-hour expiry token
BUNNY_TOKEN_KEY=your_bunny_token_key
# Email (optional — leave blank to disable transactional email)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASSWORD=
MAIL_FROM=StreamVault <aman.k@cisinlabs.com>
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_USER=your_mail_user
MAIL_PASSWORD=your_mail_password

# Frontend origin (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000,http://192.168.2.148:3000

# Affiliate program
# Commission rate paid to referrer on referred user's first payment (0.10 = 10%)
AFFILIATE_COMMISSION_RATE=0.10

# § 2257 Compliance — custodian of records
COMPLIANCE_CUSTODIAN_NAME=StreamVault Records Manager
COMPLIANCE_CUSTODIAN_ADDRESS=123 Streaming Lane, Mumbai, Maharashtra 400001, India
COMPLIANCE_CUSTODIAN_EMAIL=compliance@streamvault.com
COMPLIANCE_CUSTODIAN_PHONE=+91-XXXXXXXXXX

# File uploads
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=524288000

# Twilio account details
TWILIO_ACCOUNT_SID = AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN = your_twilio_auth_token
TWILIO_PHONE_NUMBER = +15642425922